# Copie para .env e preencha. O core lê este arquivo no boot (process.loadEnvFile).
# Sem token, deixe ADAPTER=mock e rode `npm run dev` — tudo funciona sem Discord.

ADAPTER=mock

# Para o bot de verdade:
# ADAPTER=discord
# DISCORD_TOKEN=seu-bot-token
# DISCORD_APP_ID=id-da-aplicacao

# porta do painel e da API (padrão 4319)
# PORT=4319
